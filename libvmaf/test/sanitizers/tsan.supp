# TSan suppression file for libvmaf
# Format: race_type:function_or_library_pattern
# Reference: https://github.com/google/sanitizers/wiki/ThreadSanitizerSuppressions

# Suppress benign races in third-party libsvm code
race:svm_predict_values

# Suppress known data races in framesync module.
# Pre-existing design issue: buffer state accessed across mutexes.
race:vmaf_framesync_acquire_new_buf
race:vmaf_framesync_submit_filled_data
race:vmaf_framesync_release_buf

# Suppress data race on ADM global div_lookup table.
# The table is lazily initialized by div_lookup_generator() in the ADM
# feature extractor init. Multiple threads may race to initialize the
# same static global. The initialization is idempotent (same values
# written every time), so the race is benign.
race:div_lookup_generator
race:adm_decouple
race:integer_compute_adm

# Suppress false positives in Y4M file I/O under TSan.
# The Y4M parser uses fread/fgets which TSan may report as races
# when linked with uninstrumented libc.
race:y4m_input_open
race:y4m_input_fetch_frame
race:video_input_open

# Suppress race in CPU feature detection (vmaf_init_cpu).
# Multiple threads calling vmaf_init() race to detect CPU features
# and write to a static flag. The detection is idempotent.
race:vmaf_init_cpu
race:vmaf_cpu_init

# Suppress race on global static state in libvmaf init/extract.
# Multiple VmafContext instances may race on shared globals
# during concurrent initialization and feature extraction.
race:vmaf_init
race:vmaf_feature_extractor_context_init
race:vmaf_feature_extractor_context_extract
